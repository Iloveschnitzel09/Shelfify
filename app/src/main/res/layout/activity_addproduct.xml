<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:layout_marginTop="16dp"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/product_informationen"
            android:textColor="@color/teal_700"
            android:textSize="25sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etEan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ean_eingeben"
                android:inputType="number"
                android:textColor="@color/teal_200"
                android:textColorHint="#AAAAAA"
                android:backgroundTint="@color/teal_200" />

            <Button
                android:id="@+id/btnCheckEan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Prüfen"
                android:backgroundTint="@color/teal_200"
                android:textColor="@color/teal_700" />
        </LinearLayout>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Produktname"
            android:inputType="text"
            android:textColor="@color/teal_200"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/teal_200"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ablaufdatum auswählen"
            android:inputType="date"
            android:focusable="false"
            android:textColor="@color/teal_200"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/teal_200"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/teal_200"
            android:hint="Menge (Optional)"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="@color/teal_200"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnAddProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Produkt hinzufügen"
            android:backgroundTint="@color/teal_200"
            android:textColor="@color/teal_700"/>
    </LinearLayout>
</ScrollView>